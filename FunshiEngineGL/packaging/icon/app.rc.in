/*
    FunshiEngineGL - Motor de juegos 3D con OpenGL e ImGui
    Copyright 2026 Gianfranco Ivan Enrique
    SPDX-License-Identifier: Apache-2.0

    Recurso de Windows del ejecutable: icono de la aplicacion (app.ico, que
    debe quedar junto a este .rc) y bloque VERSIONINFO (CompanyName, FileVersion,
    etc.) que los exploradores y AVs leen para identificar al binario en vez de
    tratarlo como generico/desconocido.
    Las entradas @VARIABLE@ las rellena configure_file() de CMake.
*/
#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "@FUNSHI_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @FUNSHI_VERSION_COMMA@
 PRODUCTVERSION  @FUNSHI_VERSION_COMMA@
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FunshiEngineGL"
            VALUE "FileDescription",  "FunshiEngineGL - Editor de escenas 3D"
            VALUE "FileVersion",      "@FUNSHI_VERSION@"
            VALUE "InternalName",     "FunshiEngineGL"
            VALUE "LegalCopyright",   "Copyright 2026 Gianfranco Ivan Enrique"
            VALUE "OriginalFilename", "FunshiEngineGL.exe"
            VALUE "ProductName",      "FunshiEngineGL"
            VALUE "ProductVersion",   "@FUNSHI_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END